{
  "hubs": [
    {
      "name": "TableHub",
      "route": "/hubs/table",
      "description": "Provides realtime communication for poker tables.",
      "clientMethods": [
        {
          "name": "JoinTable",
          "description": "Should called when user wants to receive table notifications",
          "parameters": [
            {
              "name": "tableId",
              "type": "Guid",
              "description": null
            }
          ]
        }
      ],
      "serverEvents": [
        {
          "name": "PlayerJoinedToLobbyNotification",
          "description": "Sent when a player joins a table lobby",
          "payloadType": "PlayerJoinedToLobbyNotification",
          "payloadSchema": {
            "type": "object",
            "properties": {
              "UserId": {
                "type": "string"
              },
              "Username": {
                "type": "string"
              }
            }
          }
        },
        {
          "name": "PlayerClaimedSeatNotification",
          "description": "Sent when a player claims a seat.",
          "payloadType": "PlayerClaimedSeatNotification",
          "payloadSchema": {
            "type": "object",
            "properties": {
              "SeatId": {
                "type": "string",
                "format": "uuid"
              },
              "UserId": {
                "type": "string"
              },
              "Username": {
                "type": "string"
              }
            },
            "required": [
              "SeatId"
            ]
          }
        },
        {
          "name": "PlayerReleasedSeatNotification",
          "description": "Sent when ap player releases a seat",
          "payloadType": "PlayerReleasedSeatNotification",
          "payloadSchema": {
            "type": "object",
            "properties": {
              "UserId": {
                "type": "string"
              },
              "SeatId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "SeatId"
            ]
          }
        }
      ]
    }
  ]
}