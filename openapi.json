{
  "openapi": "3.1.1",
  "info": {
    "title": "ChipsPocket.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7112/"
    }
  ],
  "paths": {
    "/api/realtime": {
      "get": {
        "tags": [
          "Realtime"
        ],
        "operationId": "RealtimeManifest",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/version": {
      "get": {
        "tags": [
          "ChipsPocket.Api"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnonymousTypeOfstring"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Register a new user",
        "description": "Creates a new user account using a username and password.\r\n\r\nThe username must not already be in use. If the provided credentials\r\ndo not satisfy the configured identity requirements, the validation\r\nerrors are returned to the client.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Log in",
        "description": "Authenticates a user using their username and password.\r\n\r\nIf the credentials are valid, a JWT access token is returned.\r\nThe same unauthorized response is returned when the username does not exist\r\nor the password is incorrect.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Get current user",
        "description": "Returns the profile information of the currently authenticated user.\r\n\r\nThe user is identified using the NameIdentifier claim from the\r\nauthenticated user's access token.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/tables": {
      "post": {
        "tags": [
          "Tables"
        ],
        "summary": "Create a poker table",
        "description": "Creates a new poker table for the authenticated user.\r\n\r\nThe authenticated user becomes the owner of the table and is\r\nautomatically added to the table's members.\r\n\r\nA user cannot create multiple tables with the same name.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTableRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateTableResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "description": "Conflict"
          }
        }
      }
    },
    "/api/tables/{tableId}": {
      "get": {
        "tags": [
          "Tables"
        ],
        "summary": "Get table information",
        "description": "Returns the details of a poker table, including its name and seats.\r\n\r\nThe authenticated user must be a member of the table.\r\nUsers who are not members of the table are forbidden from accessing\r\nthe table information.",
        "parameters": [
          {
            "name": "tableId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewTableInfoDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/tables/{tableId}/seats/{seatId}/claim": {
      "post": {
        "tags": [
          "Tables"
        ],
        "summary": "Claim a table seat",
        "description": "Claims a seat at a poker table for the authenticated user.\r\n\r\nThe user must be a member of the table.\r\n\r\nIf the user is already sitting at another seat at the same\r\ntable, their previous seat is released and the requested\r\nseat becomes their new seat.\r\n\r\nThe requested seat must belong to the specified table and\r\nmust not already be occupied by another user.",
        "parameters": [
          {
            "name": "tableId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "seatId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/tables/{tableId}/seats/{seatId}/release": {
      "post": {
        "tags": [
          "Tables"
        ],
        "summary": "Release a table seat",
        "description": "Releases a seat currently occupied by the authenticated user.\r\n\r\nThe user must be a member of the table players and can only\r\nrelease a seat that they currently occupy.\r\n\r\nIf the seat is already empty, the operation succeeds without\r\nmaking any changes.",
        "parameters": [
          {
            "name": "tableId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "seatId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/tables/my": {
      "get": {
        "tags": [
          "Tables"
        ],
        "summary": "Get tables the current user has joined",
        "description": "Returns a list of poker tables where the currently authenticated user\r\nis a member of the table.\r\n\r\nOnly tables associated with the current user's memberships are returned.",
        "operationId": "GetMyTables",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GetMyTablesResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tables/members/join/{token}": {
      "post": {
        "tags": [
          "Tables"
        ],
        "summary": "Join to table players",
        "description": "Adds the authenticated user to a table using a join token.\r\n\r\nIf the user is already a member of the table, no duplicate membership\r\nis created.\r\n\r\nThe join token must be valid and correspond to an existing table.\r\n\r\nOnly 10 users can be joined",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JoinResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "description": "Conflict"
          }
        }
      }
    },
    "/api/tables/{tableId}/members/join-token": {
      "get": {
        "tags": [
          "Tables"
        ],
        "summary": "Get table join token",
        "description": "Generates a short-lived token that can be shared with other users\r\nto join the table members.",
        "parameters": [
          {
            "name": "tableId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetJoinTokenResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/tables/{tableId}/members": {
      "get": {
        "tags": [
          "Tables"
        ],
        "summary": "Get table players",
        "description": "Returns the users currently in the specified table.\r\n\r\nOnly users who are members of the table can access\r\nthe list of players.",
        "parameters": [
          {
            "name": "tableId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MemberDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tables/{tableId}/members/{memberId}": {
      "delete": {
        "tags": [
          "Tables"
        ],
        "summary": "Remove a user from a table",
        "description": "Removes a user from the specified table.\r\n\r\nA table managerService can remove any user from the table except themselves.\r\nA regular user can only remove themselves from the table players.\r\n\r\nIf the user has a claimed seat at the table, the seat is released\r\nwhen the user is removed from the table players.\r\n\r\nThe operation requires authentication and the specified table must exist.",
        "parameters": [
          {
            "name": "tableId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "memberId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/tables/{tableId}/members/{memberId}/balance": {
      "post": {
        "tags": [
          "Balance"
        ],
        "summary": "Add balance to a table member",
        "description": "Adds the specified amount to a table member's balance. Only the managerService of the table can perform this operation.",
        "operationId": "AddMemberBalance",
        "parameters": [
          {
            "name": "memberId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tableId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddBalanceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Balance"
        ],
        "summary": "Deduct balance from a table member",
        "description": "Deducts the specified amount from a table member's balance. Only the managerService of the table can perform this operation. The member must have sufficient balance.",
        "operationId": "DeductMemberBalance",
        "parameters": [
          {
            "name": "value",
            "in": "query",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "memberId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tableId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Balance"
        ],
        "summary": "Get a table member's balance",
        "description": "Returns the current balance of a member at the specified table.",
        "operationId": "GetMemberBalance",
        "parameters": [
          {
            "name": "tableId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "memberId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetMemberBalanceResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/tables/{tableId}/hands": {
      "post": {
        "tags": [
          "hands"
        ],
        "description": "Endpoints for creating and managing poker hands",
        "parameters": [
          {
            "name": "tableId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewCreatedHandDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddBalanceRequest": {
        "required": [
          "value"
        ],
        "type": "object",
        "properties": {
          "value": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "AnonymousTypeOfstring": {
        "required": [
          "version"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AuthResponse": {
        "required": [
          "accessToken",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateTableRequest": {
        "required": [
          "tableName",
          "smallBlindAmount"
        ],
        "type": "object",
        "properties": {
          "tableName": {
            "type": "string"
          },
          "smallBlindAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "CreateTableResponse": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "GetJoinTokenResponse": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "GetMemberBalanceResponse": {
        "required": [
          "value"
        ],
        "type": "object",
        "properties": {
          "value": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "GetMyTablesResponse": {
        "required": [
          "tableId",
          "tableName",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "tableId": {
            "type": "string",
            "format": "uuid"
          },
          "tableName": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "JoinResponse": {
        "required": [
          "tableId"
        ],
        "type": "object",
        "properties": {
          "tableId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "username",
          "password"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "MemberDto": {
        "required": [
          "id",
          "username"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "MeResponse": {
        "required": [
          "id",
          "username",
          "email"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RegisterRequest": {
        "required": [
          "username",
          "password"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "Street": {
        "enum": [
          "PreFlop",
          "Flop",
          "Turn",
          "River",
          "Showdown",
          "Finished"
        ]
      },
      "ViewActiveHandDto": {
        "required": [
          "tableId",
          "argId",
          "dealerSeatId",
          "smallBlindSeatId",
          "bigBlindSeatId",
          "currentStreet"
        ],
        "type": "object",
        "properties": {
          "tableId": {
            "type": "string",
            "format": "uuid"
          },
          "argId": {
            "type": "string",
            "format": "uuid"
          },
          "dealerSeatId": {
            "type": "string",
            "format": "uuid"
          },
          "smallBlindSeatId": {
            "type": "string",
            "format": "uuid"
          },
          "bigBlindSeatId": {
            "type": "string",
            "format": "uuid"
          },
          "currentStreet": {
            "$ref": "#/components/schemas/Street"
          }
        }
      },
      "ViewCreatedHandDto": {
        "required": [
          "handId",
          "dealerSeatId",
          "bigBlindSeatId",
          "smallBlindSeatId"
        ],
        "type": "object",
        "properties": {
          "handId": {
            "type": "string",
            "format": "uuid"
          },
          "dealerSeatId": {
            "type": "string",
            "format": "uuid"
          },
          "bigBlindSeatId": {
            "type": "string",
            "format": "uuid"
          },
          "smallBlindSeatId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ViewSeatDto": {
        "required": [
          "id",
          "order",
