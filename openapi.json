{
  "openapi": "3.1.1",
  "info": {
    "title": "ChipsPocket.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://192.168.146.213:7112/"
    }
  ],
  "paths": {
    "/api/realtime": {
      "get": {
        "tags": [
          "Realtime"
        ],
        "operationId": "RealtimeManifest",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Register a new user",
        "description": "Creates a new user account using a username and password.\r\n\r\nThe username must not already be in use. If the provided credentials\r\ndo not satisfy the configured identity requirements, the validation\r\nerrors are returned to the client.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Log in",
        "description": "Authenticates a user using their username and password.\r\n\r\nIf the credentials are valid, a JWT access token is returned.\r\nThe same unauthorized response is returned when the username does not exist\r\nor the password is incorrect.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Get current user",
        "description": "Returns the profile information of the currently authenticated user.\r\n\r\nThe user is identified using the NameIdentifier claim from the\r\nauthenticated user's access token.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/tables": {
      "post": {
        "tags": [
          "Tables"
        ],
        "summary": "Create a poker table",
        "description": "Creates a new poker table for the authenticated user.\r\n\r\nThe authenticated user becomes the owner of the table and is\r\nautomatically added to the table's members.\r\n\r\nA user cannot create multiple tables with the same name.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTableRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateTableResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "description": "Conflict"
          }
        }
      }
    },
    "/api/tables/{tableId}": {
      "get": {
        "tags": [
          "Tables"
        ],
        "summary": "Get table information",
        "description": "Returns the details of a poker table, including its name and seats.\r\n\r\nThe authenticated user must be a member of the table.\r\nUsers who are not members of the table are forbidden from accessing\r\nthe table information.",
        "parameters": [
          {
            "name": "tableId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewTableInfoDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/tables/{tableId}/seats/{seatId}/claim": {
      "post": {
        "tags": [
          "Tables"
        ],
        "summary": "Claim a table seat",
        "description": "Claims a seat at a poker table for the authenticated user.\r\n\r\nThe user must be a member of the table.\r\n\r\nIf the user is already sitting at another seat at the same\r\ntable, their previous seat is released and the requested\r\nseat becomes their new seat.\r\n\r\nThe requested seat must belong to the specified table and\r\nmust not already be occupied by another user.",
        "parameters": [
          {
            "name": "tableId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "seatId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/tables/{tableId}/seats/{seatId}/release": {
      "post": {
        "tags": [
          "Tables"
        ],
        "summary": "Release a table seat",
        "description": "Releases a seat currently occupied by the authenticated user.\r\n\r\nThe user must be a member of the table players and can only\r\nrelease a seat that they currently occupy.\r\n\r\nIf the seat is already empty, the operation succeeds without\r\nmaking any changes.",
        "parameters": [
          {
            "name": "tableId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "seatId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/tables/{tableId}/buy-in": {
      "post": {
        "tags": [
          "Tables"
        ],
        "summary": "Create a buy-in transaction",
        "description": "Creates a buy-in transaction that transfers chips from the table shop\r\nto a user in the table players.\r\n\r\nOnly the table manager can perform a buy-in.\r\nThe destination user must currently be a member of the table.\r\nThe specified chip must exist.",
        "parameters": [
          {
            "name": "tableId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BuyInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/tables/{tableId}/cash-out": {
      "post": {
        "tags": [
          "Tables"
        ],
        "summary": "Create a cash-out transaction",
        "description": "Creates a cash-out transaction that transfers chips\r\nfrom a user to the table shop.\r\n\r\nuser should have enough chips to cash-out, otherwise it will return a bad request.\r\n\r\nOnly the table manager can perform a cash-out.\r\nThe source user must currently be a member of the\r\ntable.\r\nThe specified chip must exist.",
        "parameters": [
          {
            "name": "tableId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CashOutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/tables/{tableId}/user-stack/{userId}": {
      "get": {
        "tags": [
          "User Stack"
        ],
        "summary": "Get a user's chip stack",
        "description": "Returns the current chip stack of a user at a specific table.\r\n\r\nThe stack is calculated from all chip transactions associated\r\nwith the specified user and table. Chips received by the user\r\nare added to the stack, while chips sent by the user are removed.\r\n\r\nOnly chips with a positive balance are included in the response.",
        "operationId": "GetUserStack",
        "parameters": [
          {
            "name": "tableId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserStackResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/tables/my": {
      "get": {
        "tags": [
          "Tables"
        ],
        "summary": "Get tables the current user has joined",
        "description": "Returns a list of poker tables where the currently authenticated user\r\nis a member of the table.\r\n\r\nOnly tables associated with the current user's memberships are returned.",
        "operationId": "GetMyTables",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GetMyTablesResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tables/members/{tableId}/join-token": {
      "get": {
        "tags": [
          "Tables"
        ],
        "summary": "Get table join token",
        "description": "Generates a short-lived token that can be shared with other users\r\nto join the table members.",
        "parameters": [
          {
            "name": "tableId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetJoinTokenResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/tables/members/join/{token}": {
      "post": {
        "tags": [
          "Tables"
        ],
        "summary": "Join to table players",
        "description": "Adds the authenticated user to a table using a join token.\r\n\r\nIf the user is already a member of the table, no duplicate membership\r\nis created.\r\n\r\nThe join token must be valid and correspond to an existing table.\r\n\r\nOnly 10 users can be joined",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JoinResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "description": "Conflict"
          }
        }
      }
    },
    "/api/tables/members/{tableId}": {
      "get": {
        "tags": [
          "Tables"
        ],
        "summary": "Get table players",
        "description": "Returns the users currently in the specified table.\r\n\r\nOnly users who are members of the table can access\r\nthe list of players.",
        "parameters": [
          {
            "name": "tableId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MemberDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tables/members/{tableId}/members/{removeUserId}": {
      "delete": {
        "tags": [
          "Tables"
        ],
        "summary": "Remove a user from a table",
        "description": "Removes a user from the specified table.\r\n\r\nA table manager can remove any user from the table except themselves.\r\nA regular user can only remove themselves from the table players.\r\n\r\nIf the user has a claimed seat at the table, the seat is released\r\nwhen the user is removed from the table players.\r\n\r\nThe operation requires authentication and the specified table must exist.",
        "parameters": [
          {
            "name": "tableId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "removeUserId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/tables/{tableId}/hands": {
      "post": {
        "tags": [
          "hands"
        ],
        "description": "Endpoints for creating and managing poker hands",
        "parameters": [
          {
            "name": "tableId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewCreateHandDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/chips/chips": {
      "get": {
        "tags": [
          "Chips"
        ],
        "summary": "Get chips",
        "description": "Endpoints managing poker chips.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ViewChip"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthResponse": {
        "required": [
          "accessToken",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BuyInRequest": {
        "required": [
          "destinationUserId",
          "chipId",
          "chipCount"
        ],
        "type": "object",
        "properties": {
          "destinationUserId": {
            "type": "string"
          },
          "chipId": {
            "type": "string",
            "format": "uuid"
          },
          "chipCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "CashOutRequest": {
        "required": [
          "sourceUserId",
          "chipId",
          "chipCount"
        ],
        "type": "object",
        "properties": {
          "sourceUserId": {
            "type": "string"
          },
          "chipId": {
            "type": "string",
            "format": "uuid"
          },
          "chipCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "CreateTableRequest": {
        "required": [
          "tableName",
          "bigBlindAmount",
          "smallBlindAmount"
        ],
        "type": "object",
        "properties": {
          "tableName": {
            "type": "string"
          },
          "bigBlindAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "smallBlindAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "CreateTableResponse": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "GetJoinTokenResponse": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "GetMyTablesResponse": {
        "required": [
          "tableId",
          "tableName",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "tableId": {
            "type": "string",
            "format": "uuid"
          },
          "tableName": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "JoinResponse": {
        "required": [
          "tableId"
        ],
        "type": "object",
        "properties": {
          "tableId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "username",
          "password"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "MemberDto": {
        "required": [
          "id",
          "username"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "MeResponse": {
        "required": [
          "id",
          "username",
          "email"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RegisterRequest": {
        "required": [
          "username",
          "password"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "UserStackChipResponse": {
        "required": [
          "chipId",
          "name",
          "picture",
          "value",
          "count"
        ],
        "type": "object",
        "properties": {
          "chipId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "picture": {
            "type": "string"
          },
          "value": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "UserStackResponse": {
        "required": [
          "userId",
          "totalValue",
          "chips"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "totalValue": {
